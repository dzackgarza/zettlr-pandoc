#!/usr/bin/env bash
# Hand file arguments to an already-running Zettlr-Pandoc and return.
#
# Electron delivers the request to the singleton owner. The calling process
# waits for the application's response after opening the files. No owner, a
# stopping owner, or a failed open produces a nonzero exit.
#
# This is deliberately not `just launch-desktop`: that recipe begins by reaping
# the live dev process (assert-dev-server-stopped.py --kill), which would tear
# down the very instance that is supposed to receive the file.
set -euo pipefail

if (( $# == 0 )); then
  printf 'Usage: %s [--data-dir=DIR] FILE...\n' "${0##*/}" >&2
  exit 2
fi

for required_command in dirname readlink timeout; do
  if ! command -v "$required_command" >/dev/null 2>&1; then
    printf 'Required command is unavailable: %s\n' "$required_command" >&2
    exit 1
  fi
done

script_path=$(readlink -f -- "${BASH_SOURCE[0]}")
repo=$(cd -- "$(dirname -- "$script_path")/../.." && pwd -P)
packaged_binary="$repo/out/Zettlr-Pandoc-linux-x64/zettlr-pandoc"

# The handshake process runs the SAME packaged binary the boot launcher runs,
# so the handoff never depends on a separately built (and possibly absent or
# stale) dev webpack tree. The singleton lock is keyed by the user-data
# directory. Both processes must implement the application launch protocol.
if [[ ! -x "$packaged_binary" ]]; then
  printf 'The packaged app is not built: %s\nRun `just package` first.\n' "$packaged_binary" >&2
  exit 1
fi

# The app bounds its acknowledged delivery at 300 seconds; leave time for it
# to report that error before this outer process deadline.
status=0
timeout --kill-after=2 310 "$packaged_binary" --open-in-running-instance "$@" || status=$?

if (( status == 124 || status == 137 )); then
  printf 'The running Zettlr-Pandoc did not answer the single-instance handshake.\n' >&2
  exit 1
fi

exit "$status"
