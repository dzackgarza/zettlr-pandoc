#!/usr/bin/env node
"use strict";

/**
 * Submit one external review proposition to a running Zettlr-Pandoc instance.
 *
 * The CLI knows only the documented Agent API. Patch parsing and application
 * stay in the server, which is the one authoritative review validator.
 */

const crypto = require("crypto");
const fs = require("fs");
const http = require("http");
const path = require("path");

const PROGRAM = path.basename(process.argv[1] ?? "zettlr-pandoc-review-diff");
const AGENT_API_PROTOCOL_VERSION = "3.0.0";
// The editor answers only a caller that sends the token of its own
// environment. The launcher of the editor and this CLI read one variable.
const TOKEN_VARIABLE = "ZETTLR_AGENT_API_TOKEN";
const REQUEST_TIMEOUT_MS = 30_000;
const KNOWN_OPTIONS = new Set([
  "document",
  "patch",
  "description",
  "baseline-sha256",
  "port",
]);

function usage() {
  return [
    `Usage: ${PROGRAM} --document FILE --patch FILE --description TEXT --port N [options]`,
    "",
    "Submit one unified-diff proposition to the running Zettlr-Pandoc editor.",
    "The editor validates and applies the patch. The review appears in the",
    "annotation panel; the editor opens and focuses nothing.",
    "",
    "Required:",
    "  --document FILE       Target document path.",
    "  --patch FILE          Unified-diff proposition file.",
    "  --description TEXT    Provenance shown with the review chunk.",
    "  --port N              Agent API loopback port.",
    "",
    "Optional:",
    "  --baseline-sha256 HEX Expected SHA-256 of the working document.",
    "  -h, --help            Show this help.",
    "",
    "Environment:",
    `  ${TOKEN_VARIABLE}  The token of the Agent API (required).`,
    "",
    "Refusals:",
    "  A refusal is one JSON line {ok:false,error:{code,message,status?}} on",
    "  stderr. Exit 2: an invocation error (INVALID_INVOCATION, TOKEN_REQUIRED,",
    "  INPUT_NOT_FILE, INPUT_EMPTY). Exit 1: a refusal of the editor (its own",
    "  code), PROTOCOL_VERSION_UNSUPPORTED, DOCUMENT_NOT_FOUND, REVISION_MISMATCH,",
    "  CLI_FAILURE (a defect of the CLI), or a refusal of the transport:",
    "  INSTANCE_UNREACHABLE  No connection, or a connection lost before an answer.",
    "  REQUEST_TIMEOUT       No answer within 30 seconds.",
    "  RESPONSE_INCOMPLETE   The answer stopped after its headers.",
    "  PROTOCOL_ERROR        The answer is no JSON or not of the documented shape.",
  ].join("\n");
}

function fail(code, message, status, exitCode = 1) {
  const error = { code, message };
  if (status !== undefined) {
    error.status = status;
  }
  process.stderr.write(`${JSON.stringify({ ok: false, error })}\n`);
  process.exit(exitCode);
}

function parseArguments(argv) {
  const options = Object.create(null);
  for (let index = 0; index < argv.length; index += 1) {
    const argument = argv[index];
    if (argument === "-h" || argument === "--help") {
      process.stdout.write(`${usage()}\n`);
      process.exit(0);
    }
    if (!argument.startsWith("--")) {
      fail("INVALID_INVOCATION", `Unexpected argument: ${argument}\n\n${usage()}`, undefined, 2);
    }
    const equals = argument.indexOf("=");
    const name = equals === -1 ? argument.slice(2) : argument.slice(2, equals);
    if (!KNOWN_OPTIONS.has(name)) {
      fail("INVALID_INVOCATION", `Unknown option: --${name}\n\n${usage()}`, undefined, 2);
    }
    if (options[name] !== undefined) {
      fail("INVALID_INVOCATION", `Option --${name} was given more than once`, undefined, 2);
    }
    const value = equals === -1 ? argv[index + 1] : argument.slice(equals + 1);
    if (value === undefined || value.startsWith("--")) {
      fail("INVALID_INVOCATION", `Option --${name} requires a value`, undefined, 2);
    }
    options[name] = value;
    if (equals === -1) {
      index += 1;
    }
  }
  for (const name of ["document", "patch", "description", "port"]) {
    if (options[name] === undefined || options[name].length === 0) {
      fail("INVALID_INVOCATION", `Option --${name} is required\n\n${usage()}`, undefined, 2);
    }
  }
  return options;
}

function requireRecord(value, label, status) {
  if (typeof value !== "object" || value === null || Array.isArray(value)) {
    fail("PROTOCOL_ERROR", `${label} must be an object`, status);
  }
  return value;
}

function requireString(value, label, status) {
  if (typeof value !== "string") {
    fail("PROTOCOL_ERROR", `${label} must be a string`, status);
  }
  return value;
}

function requireInteger(value, label, status) {
  if (!Number.isInteger(value)) {
    fail("PROTOCOL_ERROR", `${label} must be an integer`, status);
  }
  return value;
}

function requireArray(value, label, status) {
  if (!Array.isArray(value)) {
    fail("PROTOCOL_ERROR", `${label} must be an array`, status);
  }
  return value;
}

function refusal(response, context) {
  const body = requireRecord(response.body, `${context} response`, response.status);
  const error = requireRecord(body.error, `${context} error`, response.status);
  const code = requireString(error.code, `${context} error code`, response.status);
  const message = requireString(error.message, `${context} error message`, response.status);
  fail(code, `${context}: ${message}`, response.status);
}

function success(response, expectedStatus, context) {
  if (response.status !== expectedStatus) {
    refusal(response, context);
  }
  return requireRecord(response.body, `${context} response`, response.status);
}

/**
 * A request that did not give a whole JSON answer. `code` is the refusal code
 * of the CLI: INSTANCE_UNREACHABLE (no connection, or a connection lost before
 * the answer), REQUEST_TIMEOUT, RESPONSE_INCOMPLETE (the body stopped after
 * its headers) or PROTOCOL_ERROR (the body is no JSON).
 */
class RequestFailure extends Error {
  constructor(code, message, status) {
    super(message);
    this.name = "RequestFailure";
    this.code = code;
    this.status = status;
  }
}

function request(port, token, method, requestPath, body) {
  const target = `${method} ${requestPath}`;
  return new Promise((resolve, reject) => {
    const payload = body === undefined ? undefined : JSON.stringify(body);
    const authorization = { Authorization: `Bearer ${token}` };
    const headers = payload === undefined
      ? authorization
      : {
          ...authorization,
          "Content-Type": "application/json",
          "Content-Length": Buffer.byteLength(payload, "utf8"),
        };
    const request = http.request(
      {
        hostname: "127.0.0.1",
        port,
        path: requestPath,
        method,
        headers,
        timeout: REQUEST_TIMEOUT_MS,
      },
      (response) => {
        const status = response.statusCode;
        let text = "";
        response.setEncoding("utf8");
        response.on("data", (chunk) => {
          text += chunk;
        });
        // A body that stops ends with "close" and no "end"; the promise
        // settles once, so a later "close" after "end" changes nothing.
        const incomplete = () => {
          reject(
            new RequestFailure(
              "RESPONSE_INCOMPLETE",
              `${target}: the Agent API answer stopped after ${text.length} characters`,
              status,
            ),
          );
        };
        response.on("error", incomplete);
        response.on("close", () => {
          if (!response.complete) {
            incomplete();
          }
        });
        response.on("end", () => {
          if (text.length === 0) {
            resolve({ status, body: undefined });
            return;
          }
          // JSON.parse throws for a body that is no JSON; the promise turns
          // that into a rejection with the code of the CLI.
          Promise.resolve(text)
            .then(JSON.parse)
            .then(
              (parsed) => resolve({ status, body: parsed }),
              (cause) =>
                reject(
                  new RequestFailure(
                    "PROTOCOL_ERROR",
                    `${target}: the Agent API answer is no JSON (${cause.message})`,
                    status,
                  ),
                ),
            );
        });
      },
    );
    request.on("timeout", () => {
      reject(
        new RequestFailure(
          "REQUEST_TIMEOUT",
          `${target}: the Agent API did not answer within ${REQUEST_TIMEOUT_MS} ms`,
        ),
      );
      request.destroy();
    });
    request.on("error", (cause) => {
      reject(
        new RequestFailure(
          "INSTANCE_UNREACHABLE",
          `${target}: no connection to the Agent API on port ${port} (${cause.code ?? cause.message})`,
        ),
      );
    });
    if (payload !== undefined) {
      request.write(payload);
    }
    request.end();
  });
}

async function main() {
  const options = parseArguments(process.argv.slice(2));
  const port = Number(options.port);
  if (!Number.isInteger(port) || port < 1 || port > 65_535) {
    fail("INVALID_INVOCATION", `Option --port must be a TCP port number: ${options.port}`, undefined, 2);
  }
  if (options["baseline-sha256"] !== undefined && !/^[0-9a-f]{64}$/.test(options["baseline-sha256"])) {
    fail("INVALID_INVOCATION", "Option --baseline-sha256 must contain 64 lowercase hexadecimal characters", undefined, 2);
  }

  const token = process.env[TOKEN_VARIABLE];
  if (token === undefined || token === "") {
    fail(
      "TOKEN_REQUIRED",
      `The environment has no ${TOKEN_VARIABLE}; the Agent API answers no caller without it`,
      undefined,
      2,
    );
  }

  const documentPath = path.resolve(options.document);
  const patchPath = path.resolve(options.patch);
  if (!fs.existsSync(patchPath) || !fs.statSync(patchPath).isFile()) {
    fail("INPUT_NOT_FILE", `Patch file does not exist: ${patchPath}`, undefined, 2);
  }
  const patch = fs.readFileSync(patchPath, "utf8");
  if (patch.length === 0) {
    fail("INPUT_EMPTY", `Patch file is empty: ${patchPath}`, undefined, 2);
  }

  const ping = success(
    await request(port, token, "GET", "/v1/ping"),
    200,
    "Agent API ping",
  );
  const protocolVersion = requireString(
    ping.protocolVersion,
    "Agent API protocol version",
    200,
  );
  if (protocolVersion !== AGENT_API_PROTOCOL_VERSION) {
    fail(
      "PROTOCOL_VERSION_UNSUPPORTED",
      `Agent API protocol ${protocolVersion} is incompatible with ${AGENT_API_PROTOCOL_VERSION}`,
      200,
    );
  }

  const listed = success(
    await request(port, token, "GET", "/v1/workspaces?include=files"),
    200,
    "workspace file listing",
  );
  const files = requireArray(listed.files, "workspace file listing files", 200);
  let documentId;
  for (const [index, entry] of files.entries()) {
    const file = requireRecord(entry, `workspace file ${index}`, 200);
    const filePath = requireString(file.path, `workspace file ${index} path`, 200);
    if (filePath === documentPath) {
      documentId = requireString(file.documentId, `workspace file ${index} documentId`, 200);
      break;
    }
  }
  if (documentId === undefined) {
    fail("DOCUMENT_NOT_FOUND", `Document is not in a configured workspace: ${documentPath}`, 404);
  }

  const content = success(
    await request(port, token, "GET", `/v1/documents/${encodeURIComponent(documentId)}?includeContent=true&side=working`),
    200,
    "working document read",
  );
  const revision = requireRecord(content.revision, "working document revision", 200);
  const workingSha256 = requireString(revision.sha256, "working document revision SHA-256", 200);
  const reviewGeneration = requireInteger(content.reviewGeneration, "working document review generation", 200);
  const declaredSha256 = options["baseline-sha256"];
  if (declaredSha256 !== undefined && declaredSha256 !== workingSha256) {
    fail(
      "REVISION_MISMATCH",
      `The working document does not match --baseline-sha256 for ${documentPath}`,
      412,
    );
  }

  const proposal = success(
    await request(
      port,
      token,
      "POST",
      `/v1/documents/${encodeURIComponent(documentId)}/proposals`,
      {
        baselineSha256: declaredSha256 ?? workingSha256,
        expectedReviewGeneration: reviewGeneration,
        clientRequestId: crypto.randomUUID(),
        claims: [{ description: options.description, patch }],
      },
    ),
    200,
    "review proposal submission",
  );
  const reviewId = requireString(proposal.reviewId, "review proposal reviewId", 200);
  const packetIds = requireArray(proposal.packetIds, "review proposal packetIds", 200)
    .map((packetId, index) => requireString(packetId, `review proposal packetIds[${index}]`, 200));

  process.stdout.write(
    `${JSON.stringify({
      ok: true,
      documentId,
      reviewId,
      packetIds,
      unresolvedChunks: requireInteger(proposal.unresolvedChunks, "review proposal unresolvedChunks", 200),
      state: requireString(proposal.state, "review proposal state", 200),
    })}\n`,
  );
}

main().then(undefined, (error) => {
  if (error instanceof RequestFailure) {
    fail(error.code, error.message, error.status);
  }
  fail("CLI_FAILURE", error instanceof Error ? error.message : String(error));
});
