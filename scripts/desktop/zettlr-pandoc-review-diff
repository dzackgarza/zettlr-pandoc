#!/usr/bin/env node
"use strict";

/**
 * Hand a review proposition to a running Zettlr-Pandoc and return.
 *
 * This is the external submission boundary for issue #34: a producer of
 * changes names a document and a unified patch, and gets an exit code. It
 * needs to know nothing about Electron, the editor's document ids, snapshot
 * tokens, or the loopback agent API -- this script performs that handshake.
 *
 *   zettlr-pandoc-review-diff --document doc.md --patch proposition.diff \
 *     --port PORT --token-environment-variable NAME \
 *     --response-deadline-ms MILLISECONDS
 *
 * The transport is the running instance's loopback agent API, which is where
 * the document buffers actually live; a second process cannot reach them any
 * other way. Every step is reported by exit code:
 *
 *   0  the review opened, with the unresolved chunk count on stdout
 *   1  the instance refused the request (unreachable, out of scope, stale
 *      baseline, unparseable or inapplicable patch) -- reason on stderr
 *   2  the invocation itself is wrong (bad flags, missing files)
 *
 * Nothing is retried and nothing is guessed: a refusal is printed with the
 * instance's own message and the process stops.
 */

const crypto = require("crypto");
const { applyPatch, parsePatch } = require("diff");
const fs = require("fs");
const http = require("http");
const path = require("path");
const { pathToFileURL } = require("url");
const {
  AGENT_API_PROTOCOL_VERSION,
} = require("../../source/types/common/agent-api-version.cjs");

const PROGRAM = path.basename(__filename);
const MAX_TIMER_DELAY_MS = 2147483647;

const KNOWN_OPTIONS = [
  "document",
  "patch",
  "description",
  "baseline-sha256",
  "port",
  "response-deadline-ms",
  "token-environment-variable",
];

function usage() {
  return [
    `usage: ${PROGRAM} --document FILE --patch FILE [options]`,
    "",
    "Submit a unified-diff proposition against a document to the running",
    "Zettlr-Pandoc, which opens it as a review with per-chunk accept/reject.",
    "",
    "Required:",
    "  --document FILE          The document the patch applies to.",
    "  --patch FILE             The proposition, as a unified diff.",
    "  --port N                 Agent API port from the editor configuration.",
    "  --token-environment-variable NAME",
    "                           Bearer-token environment key from the editor",
    "                           configuration.",
    "  --response-deadline-ms N Abort a non-responsive Agent API request after",
    "                           N milliseconds (1..2147483647).",
    "",
    "Optional:",
    "  --description TEXT       Provenance shown at the review's chunks.",
    "  --baseline-sha256 HEX    The SHA-256 of the baseline text the patch was",
    "                           computed against. When given, the request is",
    "                           refused unless the editor's live text still",
    "                           hashes to it.",
    "  -h, --help               Show this help and exit.",
    "",
    "The bearer token is read from the named environment variable. Leave that",
    "variable unset when the editor runs untokenized.",
  ].join("\n");
}

function fail(code, message, exitCode, status) {
  const error = { code, message };
  if (status !== undefined) {
    error.status = status;
  }
  process.stderr.write(`${JSON.stringify({ ok: false, error })}\n`);
  process.exit(exitCode);
}

function errorText(error) {
  return error instanceof Error ? error.message : String(error);
}

function isRecord(value) {
  return typeof value === "object" && value !== null && !Array.isArray(value);
}

function requireRecord(value, label) {
  if (!isRecord(value)) {
    throw new Error(`${label} was not an object`);
  }
  return value;
}

function requireString(value, label) {
  if (typeof value !== "string") {
    throw new Error(`${label} was not a string`);
  }
  return value;
}

function requireInteger(value, label) {
  if (!Number.isInteger(value)) {
    throw new Error(`${label} was not an integer`);
  }
  return value;
}

function requireArray(value, label) {
  if (!Array.isArray(value)) {
    throw new Error(`${label} was not an array`);
  }
  return value;
}

/** Stop on an API refusal while preserving its stable error code and status. */
function refuse(response, context) {
  const body = requireRecord(response.body, `${context} response`);
  const error = requireRecord(body.error, `${context} error`);
  fail(
    requireString(error.code, `${context} error code`),
    `${context}: ${requireString(error.message, `${context} error message`)}`,
    1,
    response.status,
  );
}

function requireSuccessBody(response, status, context) {
  if (response.status !== status) {
    refuse(response, context);
  }
  return requireRecord(response.body, `${context} response`);
}

function parseArguments(argv) {
  const options = {};
  for (let i = 0; i < argv.length; i++) {
    const argument = argv[i];
    if (argument === "-h" || argument === "--help") {
      return { help: true };
    }
    if (!argument.startsWith("--")) {
      fail("INVALID_INVOCATION", `unexpected argument: ${argument}\n\n${usage()}`, 2);
    }
    const equals = argument.indexOf("=");
    const key = equals === -1 ? argument.slice(2) : argument.slice(2, equals);
    if (!KNOWN_OPTIONS.includes(key)) {
      fail("INVALID_INVOCATION", `unknown option: --${key}\n\n${usage()}`, 2);
    }
    if (options[key] !== undefined) {
      fail("INVALID_INVOCATION", `--${key} was given twice`, 2);
    }
    const value = equals === -1 ? argv[++i] : argument.slice(equals + 1);
    if (value === undefined) {
      fail("INVALID_INVOCATION", `--${key} requires a value`, 2);
    }
    options[key] = value;
  }
  return options;
}

/** Read a file that must exist and must not be empty, or exit 2. */
function readRequiredFile(filePath, flag) {
  let text;
  try {
    text = fs.readFileSync(filePath, "utf8");
  } catch (error) {
    fail("INPUT_NOT_READABLE", `${flag} could not be read: ${errorText(error)}`, 2);
  }
  if (text.trim().length === 0) {
    fail("INPUT_EMPTY", `${flag} is empty: ${filePath}`, 2);
  }
  return text;
}

function normalizeText(text) {
  return text.replace(/^\uFEFF/, "").split(/\r\n|\n\r|\n|\r/g).join("\n");
}

function acceptablePatchHeader(fileName, documentPath) {
  if (typeof fileName !== "string") {
    return false;
  }
  const normalized = fileName.replace(/\\/g, "/");
  if (normalized === "document" || normalized === "a/document" || normalized === "b/document") {
    return true;
  }
  const carriedPrefix = /^(a|b)\//.test(normalized);
  const stripped = normalized.replace(/^(a|b)\//, "");
  if (path.isAbsolute(stripped)) {
    return path.resolve(stripped) === path.resolve(documentPath);
  }
  return carriedPrefix && path.resolve(`/${stripped}`) === path.resolve(documentPath);
}

/** Parse and validate the patch shape before any open/focus request. */
function parseReviewPatch(patchText, documentPath) {
  if (patchText.includes("GIT binary patch")) {
    throw new Error("review-diff does not support binary patches");
  }
  const patches = parsePatch(patchText);
  if (patches.length !== 1) {
    throw new Error("review-diff requires exactly one file patch");
  }
  const patch = patches[0];
  if (patch.hunks.length === 0 || patch.isBinary === true) {
    throw new Error("review-diff patch does not change the target document");
  }
  if (
    patch.isRename === true ||
    patch.isCopy === true ||
    patch.isCreate === true ||
    patch.isDelete === true ||
    patch.oldMode !== undefined ||
    patch.newMode !== undefined
  ) {
    throw new Error("review-diff does not support rename, copy, create, delete, or mode-change patches");
  }
  if (
    patch.oldFileName === "/dev/null" ||
    patch.newFileName === "/dev/null" ||
    !acceptablePatchHeader(patch.oldFileName, documentPath) ||
    !acceptablePatchHeader(patch.newFileName, documentPath)
  ) {
    throw new Error("review-diff patch headers do not match the target document");
  }
  return patch;
}

/** Apply a parsed patch against the exact text the authority will review. */
function validatePatchAgainstText(patch, documentText) {
  const normalizedDocumentText = normalizeText(documentText);
  const applied = applyPatch(normalizedDocumentText, patch, { fuzzFactor: 0 });
  if (applied === false) {
    throw new Error("review-diff patch does not apply to the current document text");
  }
  if (normalizeText(applied) === normalizedDocumentText) {
    throw new Error("review-diff patch does not change the target document");
  }
}

/** Validate an unopened document against its current disk bytes. */
function validatePatchBeforeOpen(patch, documentPath) {
  const documentText = fs.readFileSync(documentPath, "utf8");
  validatePatchAgainstText(patch, documentText);
  return normalizeText(documentText);
}

function request(
  port,
  tokenEnvironmentVariable,
  responseDeadlineMs,
  method,
  requestPath,
  body,
) {
  const headers = {};
  const token = process.env[tokenEnvironmentVariable];
  if (token !== undefined && token.length > 0) {
    headers.Authorization = `Bearer ${token}`;
  }
  let payload;
  if (body !== undefined) {
    payload = JSON.stringify(body);
    headers["Content-Type"] = "application/json";
    headers["Content-Length"] = Buffer.byteLength(payload, "utf8");
  }

  return new Promise((resolve, reject) => {
    const req = http.request(
      {
        hostname: "127.0.0.1",
        port,
        path: requestPath,
        method,
        headers,
        signal: AbortSignal.timeout(responseDeadlineMs),
      },
      (res) => {
        let text = "";
        res.setEncoding("utf8");
        res.on("data", (chunk) => {
          text += chunk;
        });
        res.on("end", () => {
          if (res.statusCode === undefined) {
            reject(new Error("Agent API response had no HTTP status."));
            return;
          }
          if (text.length === 0) {
            reject(new Error(`Agent API response for ${requestPath} had no body.`));
            return;
          }
          try {
            resolve({
              status: res.statusCode,
              body: JSON.parse(text),
            });
          } catch (error) {
            reject(
              new Error(
                `Agent API response for ${requestPath} was not JSON: ${errorText(error)}`,
              ),
            );
          }
        });
      },
    );
    req.on("error", reject);
    if (payload !== undefined) {
      req.write(payload);
    }
    req.end();
  });
}

async function main() {
  const options = parseArguments(process.argv.slice(2));
  if (options.help === true) {
    process.stdout.write(`${usage()}\n`);
    return;
  }

  for (const required of [
    "document",
    "patch",
    "port",
    "response-deadline-ms",
    "token-environment-variable",
  ]) {
    if (options[required] === undefined) {
      fail("INVALID_INVOCATION", `--${required} is required\n\n${usage()}`, 2);
    }
  }

  const port = Number(options.port);
  if (!Number.isInteger(port) || port < 1 || port > 65535) {
    fail("INVALID_INVOCATION", `--port must be a TCP port number, got: ${options.port}`, 2);
  }
  const responseDeadlineMs = Number(options["response-deadline-ms"]);
  if (
    !Number.isInteger(responseDeadlineMs) ||
    responseDeadlineMs < 1 ||
    responseDeadlineMs > MAX_TIMER_DELAY_MS
  ) {
    fail(
      "INVALID_INVOCATION",
      `--response-deadline-ms must be an integer from 1 through ${MAX_TIMER_DELAY_MS}, got: ${options["response-deadline-ms"]}`,
      2,
    );
  }
  const tokenEnvironmentVariable = options["token-environment-variable"];
  if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(tokenEnvironmentVariable)) {
    fail(
      "INVALID_INVOCATION",
      `--token-environment-variable must be an environment variable name, got: ${tokenEnvironmentVariable}`,
      2,
    );
  }
  const declaredBaseline = options["baseline-sha256"];
  if (
    declaredBaseline !== undefined &&
    !/^[0-9a-fA-F]{64}$/.test(declaredBaseline)
  ) {
    fail(
      "INVALID_INVOCATION",
      `--baseline-sha256 must be exactly 64 hexadecimal characters, got: ${declaredBaseline}`,
      2,
    );
  }

  const documentPath = path.resolve(options.document);
  let documentStat;
  try {
    documentStat = fs.statSync(documentPath);
  } catch (error) {
    fail(
      "INPUT_NOT_READABLE",
      `--document could not be read: ${errorText(error)}`,
      2,
    );
  }
  if (!documentStat.isFile()) {
    fail("INPUT_NOT_FILE", `--document is not a file: ${documentPath}`, 2);
  }
  const patchText = readRequiredFile(path.resolve(options.patch), "--patch");

  // The handshake, in the order the instance requires it. Every non-success
  // response ends the run: a half-submitted proposition is not a state this
  // boundary is allowed to leave behind.
  let ping;
  try {
    ping = await request(
      port,
      tokenEnvironmentVariable,
      responseDeadlineMs,
      "GET",
      "/v1/ping",
    );
  } catch (error) {
    fail(
      "INSTANCE_UNREACHABLE",
      `no Zettlr-Pandoc answered 127.0.0.1:${port} (${errorText(error)}). ` +
        "Start the editor, or name its port with --port.",
      1,
    );
  }
  const pingBody = requireSuccessBody(ping, 200, "agent API handshake");
  if (pingBody.protocolVersion === undefined) {
    fail(
      "UNEXPECTED_RESPONSE",
      `127.0.0.1:${port} did not identify a Zettlr-Pandoc agent API.`,
      1,
      ping.status,
    );
  }
  const protocolVersion = requireString(
    pingBody.protocolVersion,
    "agent API protocol version",
  );
  if (protocolVersion !== AGENT_API_PROTOCOL_VERSION) {
    fail(
      "PROTOCOL_VERSION_UNSUPPORTED",
      `127.0.0.1:${port} speaks agent API protocol ${protocolVersion}; ` +
        `${PROGRAM} requires ${AGENT_API_PROTOCOL_VERSION}.`,
      1,
      ping.status,
    );
  }

  let patch;
  try {
    patch = parseReviewPatch(patchText, documentPath);
  } catch (error) {
    fail("PATCH_INVALID", errorText(error), 1, 400);
  }

  // Reuse an already-loaded authority buffer. This lets a stale-baseline
  // refusal happen before any focus/open mutation. An unopened path still
  // passes the local disk validation above before the authority is loaded.
  const listed = await request(
    port,
    tokenEnvironmentVariable,
    responseDeadlineMs,
    "GET",
    "/v1/documents",
  );
  const listedBody = requireSuccessBody(listed, 200, "document list");
  const listedDocuments = requireArray(listedBody.documents, "document list");
  const existing = listedDocuments.find(
    (entry) => isRecord(entry) && entry.path === documentPath,
  );
  let documentId;
  let openedByCli = false;
  const releaseOpenedDocument = async () => {
    if (!openedByCli || documentId === undefined) {
      return;
    }
    try {
      await request(
        port,
        tokenEnvironmentVariable,
        responseDeadlineMs,
        "DELETE",
        `/v1/documents/${documentId}`,
      );
    } catch {
      // Preserve the original refusal. Cleanup is deliberately best effort:
      // the API leaves a document alone if another owner acquired a view or
      // made it dirty while this request was in flight.
    } finally {
      openedByCli = false;
    }
  };
  if (existing !== undefined) {
    documentId = requireString(existing.documentId, "documentId");
  } else {
    let diskBaselineText;
    try {
      diskBaselineText = validatePatchBeforeOpen(patch, documentPath);
    } catch (error) {
      fail("PATCH_INVALID", errorText(error), 1, 400);
    }
    if (
      declaredBaseline !== undefined &&
      declaredBaseline.toLowerCase() !== crypto.createHash("sha256").update(diskBaselineText, "utf8").digest("hex")
    ) {
      fail(
        "BASELINE_MISMATCH",
        `the document on disk for ${documentPath} is not the baseline this patch was made against: ` +
          `--baseline-sha256 ${declaredBaseline.toLowerCase()}, disk ${crypto.createHash("sha256").update(diskBaselineText, "utf8").digest("hex")}. ` +
          "Rebase the patch onto the current text and submit again.",
        1,
      );
    }
    const opened = await request(
      port,
      tokenEnvironmentVariable,
      responseDeadlineMs,
      "POST",
      "/v1/documents",
      {
        uri: pathToFileURL(documentPath).href,
      },
    );
    if (opened.status === 201) {
      openedByCli = true;
    }
    try {
      const openedBody = requireSuccessBody(opened, 201, "document open");
      documentId = requireString(openedBody.documentId, "documentId");
    } catch (error) {
      await releaseOpenedDocument();
      fail("UNEXPECTED_RESPONSE", `document open: ${errorText(error)}`, 1, opened.status);
    }
  }

  let live;
  try {
    live = await request(
      port,
      tokenEnvironmentVariable,
      responseDeadlineMs,
      "GET",
      `/v1/documents/${documentId}/content?side=working`,
    );
  } catch (error) {
    await releaseOpenedDocument();
    fail("INSTANCE_UNREACHABLE", `live document read failed: ${errorText(error)}`, 1);
  }
  if (live.status !== 200) {
    await releaseOpenedDocument();
    refuse(live, "live document read");
  }
  let liveBody;
  let snapshot;
  let liveSha256;
  try {
    liveBody = requireRecord(live.body, "live document read response");
    snapshot = requireString(liveBody.snapshot, "live document snapshot");
    const revision = requireRecord(liveBody.revision, "live document revision");
    liveSha256 = requireString(revision.sha256, "live document SHA-256");
  } catch (error) {
    await releaseOpenedDocument();
    fail("UNEXPECTED_RESPONSE", `live document read: ${errorText(error)}`, 1, live.status);
  }

  // An already-open document may contain unsaved editor text. Validate against
  // the authority response, never against disk bytes, before submitting or
  // focusing the review. The unopened path was prevalidated against disk
  // before the open request and is checked again here for a race-safe exact
  // snapshot.
  try {
    validatePatchAgainstText(patch, liveBody.content);
  } catch (error) {
    await releaseOpenedDocument();
    fail("PATCH_INVALID", errorText(error), 1, 400);
  }

  if (
    declaredBaseline !== undefined &&
    declaredBaseline.toLowerCase() !== liveSha256
  ) {
    await releaseOpenedDocument();
    fail(
      "BASELINE_MISMATCH",
      `the editor's text for ${documentPath} is not the baseline this patch was made ` +
        `against: --baseline-sha256 ${declaredBaseline.toLowerCase()}, editor ${liveSha256}. ` +
        "Rebase the patch onto the current text and submit again.",
      1,
    );
  }

  let submitted;
  try {
    submitted = await request(
      port,
      tokenEnvironmentVariable,
      responseDeadlineMs,
      "POST",
      `/v1/documents/${documentId}/proposals`,
      {
        snapshot,
        patchFormat: "unified-diff",
        patch: patchText,
        description: options.description,
        clientRequestId: crypto.randomUUID(),
      },
    );
  } catch (error) {
    await releaseOpenedDocument();
    fail("INSTANCE_UNREACHABLE", `proposition submission failed: ${errorText(error)}`, 1);
  }
  if (submitted.status !== 200) {
    await releaseOpenedDocument();
    refuse(submitted, "proposition submission");
  }
  let submittedBody;
  try {
    submittedBody = requireRecord(submitted.body, "proposition submission response");
  } catch (error) {
    await releaseOpenedDocument();
    fail("UNEXPECTED_RESPONSE", `proposition submission: ${errorText(error)}`, 1, submitted.status);
  }
  let reviewId;
  let unresolvedChunks;
  try {
    reviewId = requireString(submittedBody.reviewId, "submitted reviewId");
    unresolvedChunks = requireInteger(
      submittedBody.unresolvedChunks,
      "submitted unresolvedChunks",
    );
  } catch (error) {
    fail("UNEXPECTED_RESPONSE", `proposition submission: ${errorText(error)}`, 1, submitted.status);
  }

  // Focus is deliberately last: malformed, stale, inapplicable, or rejected
  // proposals never steal the user's active tab or reveal a partial review.
  const focused = await request(
    port,
    tokenEnvironmentVariable,
    responseDeadlineMs,
    "POST",
    `/v1/documents/${documentId}/focus`,
  );
  requireSuccessBody(focused, 200, "document focus");

  process.stdout.write(
    `${JSON.stringify({
      ok: true,
      reviewId,
      documentPath,
      unresolvedChunks,
    })}\n`,
  );
}

main().catch((error) => {
  fail("UNEXPECTED_FAILURE", errorText(error), 1);
});
