#!/usr/bin/env bash
# Build and start Zettlr-Pandoc from the repository behind the installed
# launcher symlink. The app is ready only when its Hyprland window is mapped.
set -euo pipefail

: "${HOME:?HOME must be set}"

for required_command in awk date dirname hyprctl jq just kill mkdir python3 readlink sed setsid sh sleep tail timeout tput; do
  if ! command -v "$required_command" >/dev/null 2>&1; then
    printf 'Required command is unavailable: %s\n' "$required_command" >&2
    exit 1
  fi
done

script_path=$(readlink -f -- "${BASH_SOURCE[0]}")
repo=$(cd -- "$(dirname -- "$script_path")/../.." && pwd -P)
log="$HOME/.cache/zettlr-pandoc-dev.log"
app_class="zettlr-pandoc"
launch_timeout=300

if [[ ! -f "$repo/justfile" ]]; then
  printf 'Repository justfile is unavailable: %s\n' "$repo/justfile" >&2
  exit 1
fi

app_up() {
  hyprctl clients -j 2>/dev/null |
    jq -e --arg app_class "$app_class" \
      'any(.[]; .class == $app_class)' >/dev/null
}

restore_cursor() {
  tput cnorm >/dev/null 2>&1
}

fail() {
  local message="$1"

  printf '\r\033[K\n   %s\n   See %s for details. Closing...\n\n' "$message" "$log"
  tail -n 20 "$log" | sed $'s/\x1b\\[[0-9;?]*[a-zA-Z]//g'
  sleep 8
  exit 1
}

spin_until_app_up() {
  local launch_pid="$1"
  local start=$SECONDS
  local frame_index=0
  local frames='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
  local frame
  local line
  local status

  while ! app_up; do
    if ! kill -0 "$launch_pid" 2>/dev/null; then
      status=0
      wait "$launch_pid" || status=$?
      fail "Launch exited with status $status before the app window appeared."
    fi

    if (( SECONDS - start > launch_timeout )); then
      fail "Timed out after ${launch_timeout}s; the app window never appeared."
    fi

    frame=${frames:frame_index++%${#frames}:1}
    line=$(
      tail -n 60 "$log" |
        sed $'s/\x1b\\[[0-9;?]*[a-zA-Z]//g; s/\r//g' |
        awk 'NF { line=$0 } END { print line }'
    )
    printf '\r\033[K   %s  Building & starting  %.48s' "$frame" "$line"
    sleep 0.12
  done
}

trap restore_cursor EXIT

# Zettlr is single-instance. Focus the existing window instead of starting a
# second build.
if app_up; then
  hyprctl dispatch focuswindow "class:^(${app_class})$" >/dev/null
  exit 0
fi

mkdir -p "$HOME/.cache"
printf '=== %s starting zettlr-pandoc from %s ===\n' "$(date)" "$repo" >"$log"

macro_generator="$HOME/.pandoc/bin/generate-mathjax-config.py"
macro_config="$HOME/.config/Zettlr-Pandoc/mathjax-macros.json"
macro_tmp="$HOME/.cache/zettlr-pandoc-macrogen"

if [[ ! -f "$macro_generator" ]]; then
  fail "MathJax macro generator is unavailable: $macro_generator"
fi

mkdir -p "$macro_tmp"
if ! timeout 15 python3 "$macro_generator" \
  --out-dir "$macro_tmp" \
  --json "$macro_config" >>"$log" 2>&1; then
  fail "MathJax macro refresh failed."
fi
printf '[boot] refreshed MathJax macros -> %s\n' "$macro_config" >>"$log"

printf '\n   Starting \033[1mZettlr-Pandoc\033[0m from source (dev build)\n\n'
tput civis >/dev/null 2>&1

# Detach the dev server and Electron into their own session so closing the
# splash does not terminate the running app.
setsid sh -c 'cd -- "$1" && exec just launch-desktop' sh "$repo" \
  >>"$log" 2>&1 </dev/null &
launch_pid=$!

spin_until_app_up "$launch_pid"
printf '\r\033[K'
