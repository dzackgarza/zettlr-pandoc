#!/usr/bin/env bash
set -euo pipefail

: "${HOME:?HOME must be set}"

for required_command in awk date direnv dirname flock grep hyprctl jq just kill mkdir python3 readlink sed setsid sh sleep tail timeout tput; do
  if ! command -v "$required_command" >/dev/null 2>&1; then
    printf 'Required command is unavailable: %s\n' "$required_command" >&2
    exit 1
  fi
done

script_path=$(readlink -f -- "${BASH_SOURCE[0]}")
repo=$(cd -- "$(dirname -- "$script_path")/../.." && pwd -P)
log="$HOME/.cache/zettlr-pandoc-dev.log"
app_class="zettlr-pandoc"
launch_timeout=300
rebuild_launch_timeout=660

if [[ ! -f "$repo/justfile" ]]; then
  printf 'Repository justfile is unavailable: %s\n' "$repo/justfile" >&2
  exit 1
fi

app_up() {
  local clients
  if ! clients=$(hyprctl clients -j 2>&1); then
    printf 'Could not query Hyprland for open windows: %s\n' "$clients" >&2
    exit 1
  fi

  jq -e --arg app_class "$app_class" \
    'any(.[]; .class == $app_class)' >/dev/null <<<"$clients"
}

process_alive() {
  local pid="$1"
  local probe

  if probe=$(LC_ALL=C kill -0 "$pid" 2>&1); then
    return 0
  fi
  if [[ "$probe" == *"No such process"* ]]; then
    return 1
  fi

  printf 'Could not probe launch process %s: %s\n' "$pid" "$probe" >&2
  exit 1
}

profile_running() {
  local lock="$profile/SingletonLock"
  local target

  if [[ ! -L "$lock" ]]; then
    return 1
  fi
  target=$(readlink -- "$lock")
  if [[ "${target%-*}" != "$HOSTNAME" ]]; then
    return 1
  fi
  process_alive "${target##*-}"
}

restore_cursor() {
  tput cnorm >/dev/null 2>&1
}

hold_open() {
  restore_cursor
  printf '\n   Press any key to close.'
  read -r -s -n 1
}

fail() {
  local message="$1"

  printf '\r\033[K\n   %s\n   See %s for details.\n\n' "$message" "$log"
  tail -n 20 "$log" | sed $'s/\x1b\\[[0-9;?]*[a-zA-Z]//g'
  hold_open
  exit 1
}

app_booted() {
  grep -qxE '\[Application\] (Boot|Launch) complete\.' "$log" && app_up
}

spin_until_booted() {
  local launch_pid="$1"
  local spinner_label="$2"
  local start=$SECONDS
  local frame_index=0
  local frames='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
  local frame
  local line
  local status
  local termination_error
  local launch_exited=false

  while ! app_booted; do
    if ! "$launch_exited" && ! process_alive "$launch_pid"; then
      status=0
      wait "$launch_pid" || status=$?
      if (( status != 0 )) || ! grep -qxF '[Application] Launch complete.' "$log"; then
        fail "Launch exited with status $status before the app finished booting."
      fi
      launch_exited=true
    fi

    if (( SECONDS - start > launch_timeout )); then
      if termination_error=$(LC_ALL=C kill -- -"$launch_pid" 2>&1); then
        :
      elif [[ "$termination_error" != *"No such process"* ]]; then
        fail "Could not terminate launch process group $launch_pid: $termination_error"
      fi
      fail "Timed out after ${launch_timeout}s; the app never finished booting."
    fi

    frame=${frames:frame_index++%${#frames}:1}
    elapsed=$(( SECONDS - start ))
    line=$(
      tail -n 60 "$log" |
        sed $'s/\x1b\\[[0-9;?]*[a-zA-Z]//g; s/\r//g' |
        awk 'NF { line=$0 } END { print line }'
    )
    printf '\r\033[K   %s  %s [%ss]  %.48s' "$frame" "$spinner_label" "$elapsed" "$line"
    sleep 0.12
  done
}

trap restore_cursor EXIT

mkdir -p "$HOME/.cache"
exec 9>"$HOME/.cache/zettlr-pandoc-launch.lock"
flock -w "$rebuild_launch_timeout" 9 || fail "Another desktop launch has not completed."
printf '=== %s starting zettlr-pandoc from %s ===\n' "$(date)" "$repo" >"$log"

packaged_dir="$repo/out/Zettlr-Pandoc-linux-x64"
packaged_binary="$packaged_dir/zettlr-pandoc"
stamp_file="$packaged_dir/.source-fingerprint"

profile="${XDG_CONFIG_HOME:-$HOME/.config}/Zettlr-Pandoc"
for argument in "$@"; do
  if [[ "$argument" == --data-dir=* ]]; then
    profile=${argument#--data-dir=}
    profile=${profile#\"}
    profile=${profile%\"}
    if [[ "$profile" != /* ]]; then profile="$packaged_dir/$profile"; fi
  fi
done

running=false
if profile_running; then running=true; fi

macro_config="$HOME/.pandoc/templates/css/mathjax-macros.json"

if ! "$running"; then
  if ! "$repo/scripts/desktop/zettlr-pandoc-refresh-macros" >>"$log" 2>&1; then
    fail "MathJax macro refresh failed."
  fi
  printf '[boot] %s regenerated canonical MathJax projections -> %s\n' "$(date +%T)" "$macro_config" >>"$log"
fi

if ! fingerprint=$("$repo/scripts/desktop/zettlr-pandoc-source-fingerprint" "$repo"); then
  fail "Could not fingerprint the repository source."
fi

if [[ ! -f "$HOME/.envrc" ]]; then
  fail "The environment file is unavailable: $HOME/.envrc"
fi

spinner_label='Building & starting'
if "$running" || { [[ -x "$packaged_binary" && -f "$stamp_file" ]] && [[ $(<"$stamp_file") == "$fingerprint" ]]; }; then
  printf '\n   Starting \033[1mZettlr-Pandoc\033[0m (no rebuild)\n\n'
  spinner_label='Starting (no rebuild)'
  tput civis >/dev/null 2>&1
  printf '[boot] %s launching packaged binary (existing instance or current build)\n' "$(date +%T)" >>"$log"
  debug_args=()
  if ! "$running"; then debug_args=(--remote-debugging-port=27413); fi
  setsid direnv exec "$HOME" "$packaged_binary" --ozone-platform=wayland "${debug_args[@]}" "$@" >>"$log" 2>&1 </dev/null 9>&- &
  launch_pid=$!
else
  printf '\n   Source changed \342\200\224 rebuilding \033[1mZettlr-Pandoc\033[0m before launch\n\n'
  tput civis >/dev/null 2>&1
  spinner_label='Building local package & starting'
  debug_port="--remote-debugging-port=27413"
  setsid sh -c '
    repo="$1"; binary="$2"; debug="$3"; shift 3
    cd -- "$repo" && ZETTLR_LOCAL_PACKAGE=1 just package &&
      exec direnv exec "$HOME" "$binary" --ozone-platform=wayland "$debug" "$@"
  ' sh "$repo" "$packaged_binary" "$debug_port" "$@" \
    >>"$log" 2>&1 </dev/null 9>&- &
  launch_pid=$!
  launch_timeout=$rebuild_launch_timeout
fi

spin_until_booted "$launch_pid" "$spinner_label"
printf '\r\033[K'
