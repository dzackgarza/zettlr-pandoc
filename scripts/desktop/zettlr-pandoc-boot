#!/usr/bin/env bash
# Build and start Zettlr-Pandoc from the repository behind the installed
# launcher symlink. The app is ready only when its Hyprland window is mapped.
set -euo pipefail

: "${HOME:?HOME must be set}"

for required_command in awk date dirname hyprctl jq just kill mkdir python3 readlink sed setsid sh sleep tail timeout tput; do
  if ! command -v "$required_command" >/dev/null 2>&1; then
    printf 'Required command is unavailable: %s\n' "$required_command" >&2
    exit 1
  fi
done

script_path=$(readlink -f -- "${BASH_SOURCE[0]}")
repo=$(cd -- "$(dirname -- "$script_path")/../.." && pwd -P)
log="$HOME/.cache/zettlr-pandoc-dev.log"
app_class="zettlr-pandoc"
launch_timeout=300

if [[ ! -f "$repo/justfile" ]]; then
  printf 'Repository justfile is unavailable: %s\n' "$repo/justfile" >&2
  exit 1
fi

# True once Hyprland reports a window of the app's class. A hyprctl failure is
# not "the app is not up yet" — it means the compositor cannot be queried at all,
# and silently reading that as "keep waiting" would spin until the launch timeout
# and then blame the app. Report it and stop.
app_up() {
  local clients
  if ! clients=$(hyprctl clients -j 2>&1); then
    printf 'Could not query Hyprland for open windows: %s\n' "$clients" >&2
    exit 1
  fi

  jq -e --arg app_class "$app_class" \
    'any(.[]; .class == $app_class)' >/dev/null <<<"$clients"
}

# True while the pid is alive. A signal-0 probe fails for two very different
# reasons: the process is gone (the answer this function exists to give) or the
# probe itself was refused, e.g. EPERM. Discarding stderr collapsed both into
# "dead", which would report a spurious launch failure.
process_alive() {
  local pid="$1"
  local probe

  # LC_ALL=C pins strerror to the English text matched below; without it a
  # localized "Kein Prozess vorhanden" falls through to the fatal branch and
  # aborts the launch over a process that simply exited.
  if probe=$(LC_ALL=C kill -0 "$pid" 2>&1); then
    return 0
  fi
  if [[ "$probe" == *"No such process"* ]]; then
    return 1
  fi

  printf 'Could not probe launch process %s: %s\n' "$pid" "$probe" >&2
  exit 1
}

restore_cursor() {
  tput cnorm >/dev/null 2>&1
}

fail() {
  local message="$1"

  printf '\r\033[K\n   %s\n   See %s for details. Closing...\n\n' "$message" "$log"
  tail -n 20 "$log" | sed $'s/\x1b\\[[0-9;?]*[a-zA-Z]//g'
  sleep 8
  exit 1
}

spin_until_app_up() {
  local launch_pid="$1"
  local spinner_label="$2"
  local start=$SECONDS
  local frame_index=0
  local frames='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
  local frame
  local line
  local status

  while ! app_up; do
    if ! process_alive "$launch_pid"; then
      status=0
      wait "$launch_pid" || status=$?
      fail "Launch exited with status $status before the app window appeared."
    fi

    if (( SECONDS - start > launch_timeout )); then
      fail "Timed out after ${launch_timeout}s; the app window never appeared."
    fi

    frame=${frames:frame_index++%${#frames}:1}
    line=$(
      tail -n 60 "$log" |
        sed $'s/\x1b\\[[0-9;?]*[a-zA-Z]//g; s/\r//g' |
        awk 'NF { line=$0 } END { print line }'
    )
    printf '\r\033[K   %s  %s  %.48s' "$frame" "$spinner_label" "$line"
    sleep 0.12
  done
}

trap restore_cursor EXIT

# Zettlr is single-instance, so never start a second build here. Files go to the
# instance that already holds the singleton lock, through a short-lived Electron
# process that only performs the handshake (see zettlr-pandoc-open-in-running);
# then focus the window that received them.
if app_up; then
  if (( $# > 0 )); then
    if ! "$repo/scripts/desktop/zettlr-pandoc-open-in-running" "$@"; then
      # Dwell before exiting, as fail() does. This script runs inside the splash
      # terminal, which closes the moment it returns: a failure that exits
      # immediately is one nobody can read, leaving the launch indistinguishable
      # from the silent drop described in #52.
      printf '\n   Could not open %s in the running Zettlr-Pandoc.\n\n' "$*" >&2
      sleep 8
      exit 1
    fi
  fi
  hyprctl dispatch focuswindow "class:^(${app_class})$" >/dev/null
  exit 0
fi

mkdir -p "$HOME/.cache"
printf '=== %s starting zettlr-pandoc from %s ===\n' "$(date)" "$repo" >"$log"

macro_generator="$HOME/.pandoc/bin/generate-mathjax-config.py"
macro_config="$HOME/.config/Zettlr-Pandoc/mathjax-macros.json"
macro_tmp="$HOME/.cache/zettlr-pandoc-macrogen"

if [[ ! -f "$macro_generator" ]]; then
  fail "MathJax macro generator is unavailable: $macro_generator"
fi

mkdir -p "$macro_tmp"
if ! timeout 15 python3 "$macro_generator" \
  --out-dir "$macro_tmp" \
  --json "$macro_config" >>"$log" 2>&1; then
  fail "MathJax macro refresh failed."
fi
printf '[boot] %s refreshed MathJax macros -> %s\n' "$(date +%T)" "$macro_config" >>"$log"

# Honest launches without repeat cost: the packaged build in out/ carries a
# stamp of the source fingerprint it was built from. A matching fingerprint
# means no commit, tracked edit, or untracked file has changed since that
# build — run the binary as-is. Any mismatch (or missing build) repackages
# and stamps AFTER the build succeeds, so a failed build can never be
# mistaken for current. Hot-reload development stays on `just launch-desktop`.
packaged_dir="$repo/out/Zettlr-Pandoc-linux-x64"
packaged_binary="$packaged_dir/zettlr-pandoc"
stamp_file="$packaged_dir/.source-fingerprint"

if ! fingerprint=$("$repo/scripts/desktop/zettlr-pandoc-source-fingerprint" "$repo"); then
  fail "Could not fingerprint the repository source."
fi

spinner_label='Building & starting'
if [[ -x "$packaged_binary" && -f "$stamp_file" ]] && [[ $(<"$stamp_file") == "$fingerprint" ]]; then
  printf '\n   Starting \033[1mZettlr-Pandoc\033[0m (packaged build is current \342\200\224 no rebuild)\n\n'
  spinner_label='Starting (no rebuild)'
  tput civis >/dev/null 2>&1
  printf '[boot] %s launching packaged binary (fingerprint matched, no build)\n' "$(date +%T)" >>"$log"
  # Detach into its own session so closing the splash does not terminate
  # the running app.
  setsid "$packaged_binary" "$@" >>"$log" 2>&1 </dev/null &
  launch_pid=$!
else
  printf '\n   Source changed \342\200\224 rebuilding \033[1mZettlr-Pandoc\033[0m before launch\n\n'
  tput civis >/dev/null 2>&1
  # `just package` computes and writes the stamp itself, fingerprinting
  # BEFORE the build so a mid-build edit reads as stale on the next launch.
  setsid sh -c '
    repo="$1"; binary="$2"; shift 2
    cd -- "$repo" && just package && exec "$binary" "$@"
  ' sh "$repo" "$packaged_binary" "$@" \
    >>"$log" 2>&1 </dev/null &
  launch_pid=$!
fi

spin_until_app_up "$launch_pid" "$spinner_label"
printf '\r\033[K'
