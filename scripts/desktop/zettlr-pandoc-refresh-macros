#!/usr/bin/env bash
set -euo pipefail

: "${HOME:?HOME must be set}"

macro_generator="$HOME/.pandoc/bin/generate-mathjax-config.py"

if [[ ! -f "$macro_generator" ]]; then
  printf 'MathJax macro generator is unavailable: %s\n' "$macro_generator" >&2
  exit 1
fi
timeout 15 python3 "$macro_generator"
