#!/usr/bin/env bash
set -euo pipefail

: "${HOME:?HOME must be set}"

pandoc_justfile="$HOME/.pandoc/justfile"

if [[ ! -f "$pandoc_justfile" ]]; then
  printf 'The justfile of ~/.pandoc is unavailable: %s\n' "$pandoc_justfile" >&2
  exit 1
fi
timeout 120 just --justfile "$pandoc_justfile" generate-math-macros
