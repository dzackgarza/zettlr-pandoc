{
  "name": "tikz-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "TikZ editing workbench: source-aware visual editor, Quiver, compiled preview and compiler diagnostics behind a host contract.",
  "license": "GPL-3.0",
  "scripts": {
    "standalone": "bun run standalone/server.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "update-tikz-editor-vendor": "bun run scripts/update-tikz-editor-vendor.mjs",
    "update-quiver-vendor": "bun run scripts/update-quiver-vendor.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "6.43.9",
    "@tikz-editor/lang-tikz": "0.5.1",
    "viewerjs": "1.14.0",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "less": "^4.9.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vue-tsc": "^3.3.10"
  }
}
