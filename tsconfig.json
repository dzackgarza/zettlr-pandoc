{
  "compilerOptions": {
    "target": "ESNext",
    "allowJs": true,
    "module": "commonjs",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "jsx": "preserve",
    "strictPropertyInitialization": false,
    "noImplicitAny": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "paths": {
      "source/*": [
        "./source/*"
      ],
      "@common/*": [
        "./source/common/*"
      ],
      "@providers/*": [
        "./source/app/service-providers/*"
      ],
      "@dts/*": [
        "./source/types/*"
      ],
      "@dzack/pandoc-editor": [
        "./packages/pandoc-editor/src/index.ts"
      ],
      "@dzack/pandoc-editor/*": [
        "./packages/pandoc-editor/src/*"
      ]
    }
  },
  "include": [
    "source/**/*",
    "test/**/*",
    "e2e/**/*",
    "packages/*/src/**/*",
    "packages/*/test/**/*",
    "scripts/**/*.ts"
  ],
  "ts-node": {
    "require": [
      "tsconfig-paths/register"
    ]
  }
}
