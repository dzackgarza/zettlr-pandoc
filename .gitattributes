# Force lf for sh
*.sh text eol=lf
# Ensure git treats the somewhat larger Yarn installs as binary and doesn't run
# diffs against them. (cf. https://yarnpkg.com/getting-started/qa#which-files-should-be-gitignored)
/.yarn/releases/** binary
/.yarn/plugins/** binary
# Pinned generated tikz-editor bundle; reconstruct with packages/tikz-workbench/scripts/update-tikz-editor-vendor.mjs.
/packages/tikz-workbench/vendor/tikz-editor/src/** binary
# Unified diff blank-context lines are encoded as a single space by design.
/packages/tikz-workbench/vendor/tikz-editor/ZETTLR.patch whitespace=-trailing-space
