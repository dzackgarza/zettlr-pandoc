+  if (heightPt == null || heightPt <= 0) return null;
+  const angleDeg = Number(options.get("angle") ?? "0");
+  if (!Number.isFinite(angleDeg)) return null;
+  const fileName = match[2].trim();
+  if (fileName.startsWith("/") || fileName.includes("..") || /^[a-z]+:/iu.test(fileName)) return null;
+  return { fileName, widthPt, heightPt, angleDeg };
