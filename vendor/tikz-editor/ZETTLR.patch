+export function parseImageNodeText(text: string): { fileName: string; widthPt: number; heightPt: number; angleDeg: number } | null {
+  const match = /^\\includegraphics\[([^\]]+)\]\{([^{}\r\n]+)\}$/u.exec(text.trim());
